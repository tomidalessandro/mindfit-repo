# Copiar a `.env.local` en la raíz del repo (o a `apps/worker/.env`) y completar.
# Nunca se commitea: ver .gitignore.

# El proyecto de Supabase de donde se LEE el esquema viejo.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# A dónde se ESCRIBE el esquema nuevo. Por defecto la base local.
# Para producción: la connection string del pooler de Supabase (puerto 6543).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
